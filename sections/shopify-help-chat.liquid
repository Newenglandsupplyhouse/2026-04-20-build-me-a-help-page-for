{% liquid
  assign section_id = 'shopify-help-chat-' | append: section.id
  assign chatbase_proxy_url = section.settings.chatbase_proxy_url | default: 'https://shopify-help-chat.onrender.com/finder'
  assign chatbase_url = section.settings.chatbase_url | default: 'https://shopify-help-chat.onrender.com/finder'
  assign iframe_url = chatbase_proxy_url

  if iframe_url == blank
    assign iframe_url = chatbase_url
  endif

  assign intro_heading = ''
  assign intro_body = ''
  if request.page_type == 'page'
    if page.content contains '</h1>'
      assign intro_parts = page.content | split: '</h1>'
      assign intro_heading = intro_parts[0] | strip_html | strip
      assign intro_body = intro_parts[1]
    else
      assign intro_heading = page.title
      assign intro_body = page.content
    endif
  endif
%}

<section class="shopify-chatbase-help" id="{{ section_id }}">
  {% if intro_heading != blank %}
    <header class="shopify-chatbase-help__intro">
      <h1 class="shopify-chatbase-help__intro-heading">{{ intro_heading }}</h1>
      <div class="shopify-chatbase-help__intro-actions">
        {% if intro_body != blank and intro_body != '' %}
          <details class="shopify-chatbase-help__intro-details">
            <summary class="shopify-chatbase-help__intro-summary">About this tool</summary>
            <div class="shopify-chatbase-help__intro-content">{{ intro_body }}</div>
          </details>
        {% endif %}
        {% if iframe_url != blank %}
          <button
            class="shopify-chatbase-help__reset"
            type="button"
            aria-label="Start over"
            title="Start over"
          >
            <span class="shopify-chatbase-help__reset-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M20 11a8 8 0 1 0-2.34 5.66" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M20 4v7h-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="shopify-chatbase-help__reset-text">Start over</span>
          </button>
        {% endif %}
      </div>
    </header>
  {% endif %}
  {% if iframe_url != blank %}
    <iframe
      class="shopify-chatbase-help__frame"
      src="{{ iframe_url | escape }}"
      title="Help page"
      loading="lazy"
      allow="clipboard-write; microphone"
    ></iframe>
  {% else %}
    <div class="shopify-chatbase-help__empty">
      <h2 class="shopify-chatbase-help__empty-title">Add your Chatbase help page URL</h2>
      <p class="shopify-chatbase-help__empty-text">Open this section in the theme editor and paste your Chatbase help page link.</p>
    </div>
  {% endif %}
</section>

<style>
  body.shopify-chatbase-help-page #shopify-block-ATXRGaGNOMlB0Wk1oN__ai_gen_block_3861a9f_zDmAVH {
    display: none !important;
  }

  /* NESH 2026-08-20: this page is a full-height tool. Keep the nav header only —
     announcement / utility / countdown / review bars just steal tool height. */
  body.shopify-chatbase-help-page .announcement-bar-section,
  body.shopify-chatbase-help-page .utility-bar,
  body.shopify-chatbase-help-page .gta-widget.gta-bar,
  body.shopify-chatbase-help-page [class*="GSC-BAR-"],
  body.shopify-chatbase-help-page [class*="gsc-countdown"],
  body.shopify-chatbase-help-page [id*="gsc-countdown"],
  body.shopify-chatbase-help-page [class*="ai-countdown-timer-"],
  body.shopify-chatbase-help-page [class*="CountdownTimer"] {
    display: none !important;
  }

  body.shopify-chatbase-help-page footer,
  body.shopify-chatbase-help-page .shopify-section-group-footer-group,
  body.shopify-chatbase-help-page [id*="shopify-section"][id*="footer"] {
    display: none !important;
  }

  #{{ section_id }} {
    --shopify-help-header-offset: 164px;
    --shopify-help-viewport-height: 100dvh;
    --shopify-help-safe-bottom: env(safe-area-inset-bottom, 0px);
    --shopify-help-mobile-frame-shift: 0px;
    box-sizing: border-box;
    height: calc(var(--shopify-help-viewport-height) - var(--shopify-help-header-offset));
    min-height: calc(var(--shopify-help-viewport-height) - var(--shopify-help-header-offset));
    position: relative;
    /* NESH 2026-08-20: keep this section's internal z-index (2..5) from competing with
       the sticky header (z-index 3), which made the dark bar paint over nav dropdowns.
       The section is overflow:hidden, so nothing inside needs to escape it. */
    isolation: isolate;
    background: #08080b;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  #{{ section_id }} .shopify-chatbase-help__intro {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    flex-wrap: wrap;
    padding: 10px 16px;
    background: #08080b;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    z-index: 4;
  }

  #{{ section_id }} .shopify-chatbase-help__intro-heading {
    margin: 0;
    color: #f5f5f7;
    font-size: 15px;
    line-height: 1.3;
    letter-spacing: -0.01em;
    font-weight: 600;
  }

  #{{ section_id }} .shopify-chatbase-help__intro-details {
    position: relative;
  }

  #{{ section_id }} .shopify-chatbase-help__intro-summary {
    color: #a2a3aa;
    cursor: pointer;
    font-size: 12.5px;
    font-weight: 600;
    list-style-position: inside;
    user-select: none;
  }

  #{{ section_id }} .shopify-chatbase-help__intro-summary:hover {
    color: #f5f5f7;
  }

  #{{ section_id }} .shopify-chatbase-help__intro-content {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    width: min(560px, calc(100vw - 32px));
    max-height: min(55vh, calc(var(--shopify-help-viewport-height) - var(--shopify-help-header-offset) - 96px));
    overflow: auto;
    background: #111116;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    padding: 16px 18px;
    z-index: 5;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.55);
  }

  #{{ section_id }} .shopify-chatbase-help__intro-content h2 {
    margin: 12px 0 6px;
    color: #f5f5f7;
    font-size: 14px;
    line-height: 1.35;
  }

  #{{ section_id }} .shopify-chatbase-help__intro-content p,
  #{{ section_id }} .shopify-chatbase-help__intro-content li {
    color: #c7c8cd;
    font-size: 13px;
    line-height: 1.55;
    margin: 6px 0;
  }

  #{{ section_id }} .shopify-chatbase-help__intro-content ul {
    margin: 8px 0;
    padding-left: 18px;
  }

  #{{ section_id }} .shopify-chatbase-help__intro-content strong {
    color: #f5f5f7;
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      --shopify-help-header-offset: 0px;
      position: fixed;
      left: 0;
      right: 0;
      top: var(--shopify-help-header-offset);
      bottom: 0;
      z-index: 2;
    }
  }

  #{{ section_id }} .shopify-chatbase-help__frame {
    display: block;
    width: 100%;
    flex: 1 1 auto;
    height: auto;
    min-height: 0;
    border: 0;
    background: #08080b;
    transform: translateY(var(--shopify-help-mobile-frame-shift));
    transform-origin: top center;
    touch-action: pan-y;
  }

  #{{ section_id }} .shopify-chatbase-help__empty {
    flex: 1 1 auto;
    height: auto;
    min-height: 0;
    display: grid;
    place-items: center;
    padding: 24px;
    text-align: center;
    color: #f5f5f7;
    background: #08080b;
  }

  #{{ section_id }} .shopify-chatbase-help__empty-title {
    margin: 0 0 10px;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  #{{ section_id }} .shopify-chatbase-help__empty-text {
    margin: 0;
    max-width: 560px;
    color: #a2a3aa;
    font-size: 1rem;
    line-height: 1.6;
  }

  #{{ section_id }} .shopify-chatbase-help__intro-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  #{{ section_id }} .shopify-chatbase-help__reset {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 28px;
    padding: 0 12px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: transparent;
    color: #a2a3aa;
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  #{{ section_id }} .shopify-chatbase-help__reset:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.22);
    color: #f5f5f7;
  }

  #{{ section_id }} .shopify-chatbase-help__reset:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.45);
    outline-offset: 2px;
  }

  #{{ section_id }} .shopify-chatbase-help__reset-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #{{ section_id }} .shopify-chatbase-help__reset-icon svg {
    width: 15px;
    height: 15px;
  }

  @media screen and (max-width: 749px) {
    body.shopify-chatbase-help-page .announcement-bar-section,
    body.shopify-chatbase-help-page .utility-bar,
    body.shopify-chatbase-help-page [class*="gsc-countdown"],
    body.shopify-chatbase-help-page [class*="gsc-countdown-widget"],
    body.shopify-chatbase-help-page [id*="gsc-countdown"],
    body.shopify-chatbase-help-page [class*="ai-countdown-timer-"],
    body.shopify-chatbase-help-page [class*="CountdownTimer"],
    body.shopify-chatbase-help-page countdown-timer-abhzcb2vcdgw1vgvzvaigenblock042d294t6ggty {
      display: none !important;
      pointer-events: none !important;
      visibility: hidden !important;
      max-height: 0 !important;
      overflow: hidden !important;
    }

    #{{ section_id }} .shopify-chatbase-help__reset {
      min-height: 26px;
      padding: 0 10px;
      font-size: 11.5px;
      pointer-events: auto;
      touch-action: manipulation;
    }

    #{{ section_id }} .shopify-chatbase-help__intro {
      padding: 7px 12px;
    }

    #{{ section_id }} .shopify-chatbase-help__intro-heading {
      font-size: 13.5px;
    }

    #{{ section_id }} .shopify-chatbase-help__intro-summary {
      font-size: 12px;
    }

    #{{ section_id }} .shopify-chatbase-help__intro-content {
      position: fixed;
      left: 12px;
      right: 12px;
      top: auto;
      width: auto;
      max-height: 60vh;
    }
  }
</style>

<script>
  (() => {
    const root = document.getElementById({{ section_id | json }});
    if (!root) {
      return;
    }

    const pageRoot = document.documentElement;
    const body = document.body;

    if (pageRoot) {
      pageRoot.style.overflow = "hidden";
      pageRoot.style.height = "100%";
    }

    if (body) {
      body.classList.add("shopify-chatbase-help-page");
      body.style.overflow = "hidden";
      body.style.height = "100%";
      body.style.minHeight = "100%";
    }

    const frame = root.querySelector(".shopify-chatbase-help__frame");
    const resetButton = root.querySelector(".shopify-chatbase-help__reset");
    const isMobileViewport = () => window.innerWidth <= 749;
    const isPortraitMobileViewport = () => isMobileViewport() && window.innerHeight >= window.innerWidth;
    const frameOrigin = frame ? new URL(frame.getAttribute("src"), window.location.href).origin : "";

    const setMobileFrameShift = (shift) => {
      const nextShift = (isMobileViewport() && !isPortraitMobileViewport()) ? -Math.max(0, Math.round(Number(shift) || 0)) : 0;
      root.style.setProperty("--shopify-help-mobile-frame-shift", `${nextShift}px`);
    };

    const updateViewportHeight = () => {
      const viewportHeight = isMobileViewport()
        ? window.innerHeight
        : (window.visualViewport?.height || window.innerHeight);
      root.style.setProperty("--shopify-help-viewport-height", `${Math.round(viewportHeight)}px`);
    };

    const updateHeaderOffset = () => {
      const selectors = [
        'header',
        '[role="banner"]',
        '.section-header',
        '.header-wrapper',
        '.shopify-section-group-header-group',
        '[id*="shopify-section"][id*="header"]',
        '.announcement-bar',
        '.utility-bar',
        '.top-bar'
      ];

      const candidates = selectors
        .flatMap((selector) => [...document.querySelectorAll(selector)])
        .filter((element, index, array) => array.indexOf(element) === index)
        .filter((element) => !root.contains(element))
        .filter((element) => {
          const rect = element.getBoundingClientRect();
          const style = window.getComputedStyle(element);

          if (style.display === "none" || style.visibility === "hidden") {
            return false;
          }

          if (rect.height <= 0 || rect.height > 320) {
            return false;
          }

          return rect.bottom > 0 && rect.top < window.innerHeight * 0.5;
        });

      const measuredOffset = candidates.reduce((maxBottom, element) => {
        const rect = element.getBoundingClientRect();
        return Math.max(maxBottom, Math.ceil(rect.bottom));
      }, 0);

      const fallbackOffset = window.innerWidth <= 749 ? 0 : 164;
      // NESH 2026-08-20: trust a real measurement when we have one. The 164px desktop
      // floor was reserving room for announcement bars this page no longer renders,
      // which cost the tool ~40px of height.
      const headerOffset = measuredOffset > 0 ? measuredOffset : fallbackOffset;

      root.style.setProperty("--shopify-help-header-offset", `${headerOffset}px`);
    };

    const disableMobileTopTapInterference = () => {
      if (!isMobileViewport()) {
        [...document.querySelectorAll("[data-shopify-help-mobile-pass-through='true']")].forEach((element) => {
          element.style.pointerEvents = "";
          delete element.dataset.shopifyHelpMobilePassThrough;
        });
        return;
      }

      const selectors = [
        "[id*='countdown']",
        "[class*='countdown']",
        "[id*='timer']",
        "[class*='timer']",
        "[id*='shipping']",
        "[class*='shipping']",
        "[id*='announcement']",
        "[class*='announcement']"
      ];

      const textMatchers = [
        "same day shipping",
        "order by",
        "days",
        "hours",
        "mins",
        "secs"
      ];

      const candidates = selectors
        .flatMap((selector) => [...document.querySelectorAll(selector)])
        .filter((element, index, array) => array.indexOf(element) === index)
        .filter((element) => !root.contains(element))
        .filter((element) => {
          const rect = element.getBoundingClientRect();
          if (rect.height <= 0 || rect.height > 260 || rect.bottom <= 0 || rect.top > window.innerHeight * 0.5) {
            return false;
          }

          const text = (element.textContent || "").trim().toLowerCase();
          return textMatchers.some((matcher) => text.includes(matcher));
        });

      candidates.forEach((element) => {
        element.style.pointerEvents = "none";
        element.dataset.shopifyHelpMobilePassThrough = "true";
      });
    };

    const scrollDesktopPageToTop = () => {
      if (isMobileViewport()) {
        return;
      }

      try {
        if ("scrollRestoration" in history) {
          history.scrollRestoration = "manual";
        }
      } catch {}

      try {
        document.documentElement.scrollTop = 0;
        document.body.scrollTop = 0;
      } catch {}

      try {
        window.scrollTo({ top: 0, left: 0, behavior: "auto" });
      } catch {
        window.scrollTo(0, 0);
      }
    };

    window.addEventListener("message", (event) => {
      if (!frame || event.origin !== frameOrigin || !event.data) {
        return;
      }

      if (event.data.type !== "nesh-chatbase-mobile-offset") {
        return;
      }

      if (!isMobileViewport()) {
        setMobileFrameShift(0);
        return;
      }

      setMobileFrameShift(event.data.active ? event.data.shift : 0);
    });

    if (frame && resetButton) {
      const initialSrc = frame.getAttribute("src");
      const loadFreshFrame = () => {
        scrollDesktopPageToTop();
        setMobileFrameShift(0);
        const baseUrl = new URL(initialSrc, window.location.href);
        const freshUrl = new URL(baseUrl.toString());
        freshUrl.searchParams.set("reset", String(Date.now()));
        // finder state lives in-page; a fresh load is a full reset
        const resetUrl = freshUrl;
        frame.setAttribute("src", "about:blank");
        window.setTimeout(() => {
          frame.setAttribute("src", resetUrl.toString());
          scrollDesktopPageToTop();
        }, 20);
        window.setTimeout(scrollDesktopPageToTop, 120);
        window.setTimeout(scrollDesktopPageToTop, 400);
      };

      frame.addEventListener("load", () => {
        scrollDesktopPageToTop();
        window.setTimeout(scrollDesktopPageToTop, 50);
        window.setTimeout(scrollDesktopPageToTop, 250);
      });

      resetButton.addEventListener("mousedown", (event) => {
        event.preventDefault();
      });

      resetButton.addEventListener("click", () => {
        try {
          resetButton.blur();
        } catch {}
        loadFreshFrame();
      });

      if (!isMobileViewport()) {
        loadFreshFrame();
      }
    }

    const introDetails = root.querySelector(".shopify-chatbase-help__intro-details");
    if (introDetails) {
      introDetails.addEventListener("toggle", () => {
        // NESH 2026-08-20: measure how many people actually open "About this tool".
        // Guarded on .open because "toggle" also fires on close, which would double-count.
        if (introDetails.open && typeof window.gtag === "function") {
          window.gtag("event", "about_tool_open");
        }
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && introDetails.open) introDetails.open = false;
      });
    }

    updateViewportHeight();
    updateHeaderOffset();
    disableMobileTopTapInterference();
    if (!isMobileViewport()) {
      scrollDesktopPageToTop();
      window.visualViewport?.addEventListener("resize", updateViewportHeight);
      window.visualViewport?.addEventListener("scroll", updateViewportHeight);
      window.addEventListener("load", scrollDesktopPageToTop);
      window.addEventListener("pageshow", scrollDesktopPageToTop);
      document.addEventListener("readystatechange", scrollDesktopPageToTop);
      setTimeout(scrollDesktopPageToTop, 50);
      setTimeout(scrollDesktopPageToTop, 250);
      setTimeout(scrollDesktopPageToTop, 750);
    }
    window.addEventListener("orientationchange", updateViewportHeight);
    window.addEventListener("orientationchange", disableMobileTopTapInterference);
    window.addEventListener("resize", updateViewportHeight);
    window.addEventListener("resize", () => setMobileFrameShift(0));
    window.addEventListener("resize", updateHeaderOffset);
    window.addEventListener("resize", disableMobileTopTapInterference);
    window.addEventListener("load", updateHeaderOffset);
    window.addEventListener("load", updateViewportHeight);
    window.addEventListener("load", disableMobileTopTapInterference);
    setTimeout(updateHeaderOffset, 250);
    setTimeout(updateHeaderOffset, 1000);
    setTimeout(updateViewportHeight, 250);
    setTimeout(disableMobileTopTapInterference, 250);
    setTimeout(disableMobileTopTapInterference, 1000);
    setTimeout(disableMobileTopTapInterference, 2000);
  })();
</script>


<p style="text-align:center;font-size:13px;line-height:1.6;color:#8a94a6;margin:26px auto 10px;max-width:640px;padding:0 16px">This AI Parts Finder is built by <a href="https://arcturus-consulting.com/parts-finder/" style="color:#2563eb;text-decoration:underline" rel="noopener">Arcturus Consulting</a> &mdash; add plain-English parts search to your own store.</p>

